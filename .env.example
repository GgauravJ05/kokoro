# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Data ingestion -----------------------------------------------------------
KOKORO_ANILIST_ENDPOINT=https://graphql.anilist.co
KOKORO_JIKAN_ENDPOINT=https://api.jikan.moe/v4
# Politeness: requests/second against public APIs. Do not raise these.
KOKORO_ANILIST_RPS=1.0
KOKORO_JIKAN_RPS=0.5
KOKORO_USER_AGENT=kokoro-research/0.1 (+https://github.com/GgauravJ05/kokoro)

# --- Paths --------------------------------------------------------------------
KOKORO_DATA_DIR=./data
KOKORO_ARTIFACT_DIR=./artifacts

# --- Training -----------------------------------------------------------------
KOKORO_DEVICE=auto          # auto | cpu | cuda | mps
KOKORO_SEED=1337

# --- Experiment tracking (optional) -------------------------------------------
WANDB_API_KEY=
WANDB_PROJECT=kokoro
