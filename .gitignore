# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Distribution / packaging
build/
dist/
sdist/
wheels/
*.egg-info/
*.egg
.eggs/

# Environments
.venv/
venv/
env/
ENV/
.python-version

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.hypothesis/
.tox/
.nox/

# Notebooks
.ipynb_checkpoints/
notebooks/scratch/

# Secrets & local config
.env
.env.*
!.env.example
*.pem
*.key
secrets.toml

# Data — raw and derived corpora stay out, with two deliberate exceptions
# below. Note `dir/*` rather than `dir/`: git cannot re-include a file whose
# parent directory is itself excluded, so the negations would never apply.
data/raw/*
data/interim/*
data/processed/*
!data/**/.gitkeep
*.parquet
*.feather
*.duckdb
*.sqlite
*.sqlite3

# Shipped so a fresh clone can run `make demo` without rebuilding the corpus.
# Both derive ONLY from the MIT-licensed catalog and the CC0 tag dump; neither
# contains review text or user ratings, whose sources declare "other" and no
# licence respectively and are therefore never redistributed.
!data/processed/titles.parquet
!data/processed/manifest.json

# Model artifacts
artifacts/*
checkpoints/
*.pt
*.pth
*.onnx
*.safetensors
*.faiss
*.bin

# The serving bundle is shipped: it is this project's own model output, and
# without it the demo cannot run from a clone. The larger off-the-shelf
# embeddings are not shipped — they are reproducible in one command and add
# 15 MB for nothing.
!artifacts/two_tower/
artifacts/two_tower/*
!artifacts/two_tower/item_embeddings_trained.npy
!artifacts/two_tower/query_tower.pt
!artifacts/two_tower/item_ids.npy
!artifacts/two_tower/axis_values.npy
!artifacts/two_tower/training.json

# Experiment tracking
wandb/
mlruns/
lightning_logs/
outputs/
runs/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
!.vscode/extensions.json
